# Copy to .env and fill in. .env is git-ignored; real environment variables take precedence.

# Environment endpoints - referenced as ${NAME} in config.json, so no host names live in the repository.
NDC_BASE_URL="https://your-ndc-api-host.example.com/"
DASHBOARDS_URL="https://your-opensearch-dashboards.example.com:5601/"
DASHBOARDS_TENANT="your-tenant"
# Discover index pattern id (Dashboards Management > Index patterns, the id in the URL) and the index to query
DASHBOARDS_INDEX_PATTERN_ID=""
DASHBOARDS_INDEX="your-log-index*"

# OpenSearch Dashboards login used by the Playwright validator. Quote the password if it contains '#'.
DASHBOARDS_USERNAME=
DASHBOARDS_PASSWORD=""

# Comma-separated REAL supplier credential values that must never appear in logs.
# (Or one per line in secrets.local.txt.) Values shorter than 4 chars are ignored.
KNOWN_SECRETS=

# NDC API auth - sent on every call as the x-api-key and Client-Id headers (401 without them).
NDC_API_KEY=""
CLIENT_ID="NDC-Core"

# Optional: extra Authorization header value, only if an environment requires one.
# NDC_API_AUTHORIZATION=
